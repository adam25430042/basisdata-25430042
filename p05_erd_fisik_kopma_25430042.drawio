<mxGeometry x="0" y="146" width="500" height="28" as="geometry"/></mxCell><mxCell id="c53" value="stok_barang INT NOT NULL DEFAULT 0, CHECK &amp;gt;= 0 (AB-03)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=10;fontSize=13;strokeColor=#e3e3e3;fillColor=none;" vertex="1" parent="ent_barang"><mxGeometry x="0" y="174" width="500" height="28" as="geometry"/></mxCell><mxCell id="c54" value="stok_min_barang INT NOT NULL DEFAULT 5" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=10;fontSize=13;strokeColor=#e3e3e3;fillColor=none;" vertex="1" parent="ent_barang"><mxGeometry x="0" y="202" width="500" height="28" as="geometry"/></mxCell><mxCell id="ent_detail_pembelian" value="detail_pembelian" style="swimlane;fontStyle=1;fontSize=15;startSize=34;html=1;whiteSpace=wrap;collapsible=0;fillColor=#fad7ac;strokeColor=#b46504;swimlaneFillColor=#ffffff;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1290" y="964" width="500" height="170" as="geometry"/></mxCell><mxCell id="c55" value="PK,FK id_pembelian INT UNSIGNED NOT NULL → pembelian, ON&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;DELETE CASCADE" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=10;fontSize=13;fontStyle=1;strokeColor=#e3e3e3;fillColor=none;" vertex="1" parent="ent_detail_pembelian"><mxGeometry x="0" y="34" width="500" height="46" as="geometry"/></mxCell><mxCell id="c56" value="PK,FK id_barang INT UNSIGNED NOT NULL → barang" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=10;fontSize=13;fontStyle=1;strokeColor=#e3e3e3;fillColor=none;" vertex="1" parent="ent_detail_pembelian"><mxGeometry x="0" y="80" width="500" height="28" as="geometry"/></mxCell><mxCell id="c57" value="qty_detail_pembelian INT NOT NULL, CHECK &amp;gt; 0 (AB-06)" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=10;fontSize=13;strokeColor=#e3e3e3;fillColor=none;" vertex="1" parent="ent_detail_pembelian"><mxGeometry x="0" y="108" width="500" height="28" as="geometry"/></mxCell><mxCell id="c58" value="harga_beli_detail_pembelian DECIMAL(12,2) NOT NULL, CHECK &amp;gt;= 0" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=nowrap;spacingLeft=10;fontSize=13;strokeColor=#e3e3e3;fillColor=none;" vertex="1" parent="ent_detail_pembelian"><mxGeometry x="0" y="136" width="500" height="28" as="geometry"/></mxCell><mxCell id="c59" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;PK = kunci primer, UQ = kunci unik, FK = kunci tamu, PK,FK = kunci&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;primer komposit.&lt;br&gt;AI = AUTO_INCREMENT. Tipe data, NULL / NOT NULL, DEFAULT, CHECK,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;dan ENUM ditulis sama persis dengan skrip DDL.&lt;br&gt;→ tabel = tujuan kunci tamu. ON DELETE hanya ditulis bila bukan&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;bawaan (bawaan = RESTRICT).&lt;br&gt;[PDP] = data pribadi menurut kamus data: boleh kosong dan akses&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;terbatas.&lt;br&gt;Nilai turunan (subtotal, diskon rupiah, total, potongan poin, saldo poin)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;tidak digambar.&lt;br&gt;Simbol Crow&#x27;s Foot dan label di ujung garis: 1 = tepat satu, 0..1 = nol&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;atau satu, 0..N = nol atau banyak, 1..N = satu atau banyak.&lt;br&gt;Sumber: p05_ddl_kopma_25430042.sql. Kode AB-xx merujuk&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;p02_kebutuhan_data_kopma_25430042.md." style="rounded=0;html=1;whiteSpace=nowrap;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="50" y="588" width="500" height="324" as="geometry"/></mxCell><mxCell id="c60" value="Dibuat oleh: ADAM MAULANA FIRMANSYAH - 25430042 - Kelas B" style="text;html=1;align=right;verticalAlign=middle;fontStyle=1;fontSize=13;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1890" y="1246" widt