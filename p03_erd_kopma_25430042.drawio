<mxCell id="legenda" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;PK = kunci primer, FK = kunci tamu, PK,FK = kunci primer komposit, AK = kunci alternatif (unik)&lt;br&gt;/ atribut (turunan) = nilai dihitung dari atribut lain, tidak disimpan&lt;br&gt;Simbol Crow's Foot dan label di ujung garis: 1 = tepat satu, 0..1 = nol atau satu, 0..N = nol atau banyak, 1..N = satu atau banyak&lt;br&gt;Simbol di dekat sebuah entitas menyatakan jumlah entitas itu untuk satu entitas di seberang garis." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1180" height="100" as="geometry"/></mxCell><mxCell id="ttd" value="Dibuat oleh: ADAM MAULANA FIRMANSYAH - 25430042 - Kelas B" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=middle;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300" y="740" width="800" height="40" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>